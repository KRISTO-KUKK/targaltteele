# Server
PORT=8787
NODE_ENV=development

# Optional OpenAI integration. Keep the real key outside git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000

# CORS is only needed when the frontend and API run on different origins.
ALLOWED_ORIGIN=

# Use both base-path variables only when deploying under a subpath.
APP_BASE_PATH=
VITE_BASE_PATH=/
VITE_API_BASE_PATH=

# Production server location for the built Vite client.
CLIENT_DIST_DIR=dist/client

# Set LOG_LEVEL=debug for detailed API diagnostics.
LOG_LEVEL=info
